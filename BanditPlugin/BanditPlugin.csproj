<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- RocketMod builds targeting current Unturned typically use net48. If your RocketMod/
         Unturned install uses a different target framework, change this to match. -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>BanditPlugin</AssemblyName>
    <RootNamespace>BanditPlugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Generated rather than hand-written: there is no AssemblyInfo.cs, so without this the
         DLL ships with no version at all, and a server admin holding one has no way to tell
         which build it is. The tagged release workflow checks its tag against this number. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Product>BanditPlugin</Product>
    <Authors>peterferenc</Authors>
    <Description>AI bandit bots for Unturned - they shoot, take cover, drive and run convoys.</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Reference paths come from Directory.Build.props, which is NOT checked in (machine-specific).
       Copy Directory.Build.props.example to Directory.Build.props and fill in your local paths. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(UnturnedManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AstarPathfindingProject">
      <HintPath>$(UnturnedManagedPath)\AstarPathfindingProject.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Drawing">
      <HintPath>$(UnturnedManagedPath)\Drawing.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PackageTools">
      <HintPath>$(UnturnedManagedPath)\PackageTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(UnturnedManagedPath)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SDG.NetTransport">
      <HintPath>$(UnturnedManagedPath)\SDG.NetTransport.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SDG.NetPak.Runtime">
      <HintPath>$(UnturnedManagedPath)\SDG.NetPak.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(UnturnedManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnturnedManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- WheelCollider lives here rather than in PhysicsModule, and the vehicle footprint has to
         measure wheels: their undersides are what the vehicle rests on. -->
    <Reference Include="UnityEngine.VehiclesModule">
      <HintPath>$(UnturnedManagedPath)\UnityEngine.VehiclesModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(UnturnedManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Rocket.API">
      <HintPath>$(RocketModPath)\Rocket.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rocket.Core">
      <HintPath>$(RocketModPath)\Rocket.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rocket.Unturned">
      <HintPath>$(RocketModPath)\Rocket.Unturned.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Used to stop bandits counting against the server's player slots - see BanditSlotPatches.
       Pinned to 2.2.2 rather than taking the newest: uEssentials ships its own 0Harmony.dll and,
       if it is installed, whichever copy loads first wins for the whole AppDomain. Matching the
       version it bundles means it does not matter which one that is.

       This one DOES copy to the output folder (no Private=false): 0Harmony.dll has to be deployed
       into Rocket/Libraries/ alongside the plugin, which is where RocketMod resolves shared
       assemblies from. -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
  </ItemGroup>

</Project>
